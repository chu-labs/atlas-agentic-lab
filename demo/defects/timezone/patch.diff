 """Renewal window logic. Dates are business dates in the business timezone."""
 from __future__ import annotations
 
-from datetime import date, datetime, timedelta
+from datetime import UTC, date, datetime, time, timedelta
 from zoneinfo import ZoneInfo
 
+BUSINESS_TZ = ZoneInfo("Australia/Sydney")
+
+
+def _expiry_utc(policy: Policy) -> date:
+    """Expiry as a UTC calendar date so it compares consistently with server timestamps."""
+    return datetime.combine(policy.expiry_date, time.min, tzinfo=BUSINESS_TZ).astimezone(UTC).date()
+
 from .models import Policy
 
 
@@ -29,9 +36,9 @@ def due_for_renewal(policies: list[Policy], today: date, days: int = 30) -> list
 
 
 def days_until_expiry(policy: Policy, today: date) -> int:
-    return (policy.expiry_date - today).days
+    return (_expiry_utc(policy) - today).days
 
 
 def has_expired(policy: Policy, today: date) -> bool:
     """A policy is expired the day after its expiry date; on the expiry date itself it is still in force."""
-    return policy.expiry_date < today
+    return _expiry_utc(policy) < today
